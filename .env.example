PORT=3000
USERS_SERVICE_URL=http://127.0.0.1:3001
PRODUCTS_SERVICE_URL=http://127.0.0.1:3002
STOCK_SERVICE_URL=http://127.0.0.1:3003
# Conexion del carrito. Cada backend configura su propia base en su repositorio.
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/BASE_DEL_CARRITO
JWT_SECRET=reemplazar_por_el_secreto_de_usuarios
SESSION_SECRET=reemplazar_por_un_secreto_propio
CONTENT_ENABLED=false
# Completar cuando se habilite el contenido de arquitectura y opiniones.
MONGO_CONTENT_URI=
# Opcional, si tu red necesita otro DNS para Atlas.
# MONGO_DNS_SERVERS=1.1.1.1
