PORT=3000
USERS_PORT=3001
PRODUCTS_PORT=3002
STOCK_PORT=3003
USERS_SERVICE_URL=http://127.0.0.1:3001
PRODUCTS_SERVICE_URL=http://127.0.0.1:3002
STOCK_SERVICE_URL=http://127.0.0.1:3003
# Render usa automáticamente su PORT y 0.0.0.0; las URLs allí deben ser HTTPS públicas.
# SERVICE_TIMEOUT_MS=180000
# Bases independientes dentro del mismo clúster de MONGO_URI:
MONGO_USERS_DB=noir_users
MONGO_PRODUCTS_DB=noir_products
MONGO_STOCK_DB=noir_inventory
# Clave privada compartida entre productos y stock; usar un valor aleatorio propio.
INTERNAL_SERVICE_SECRET=reemplazar_por_un_secreto_aleatorio
# Opcionales: conexiones con credenciales o clústeres específicos por servicio.
# MONGO_USERS_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/BASE_USUARIOS
# MONGO_PRODUCTS_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/BASE_PRODUCTOS
# MONGO_STOCK_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/BASE_INVENTARIO
# Las variables MONGO_*_DB determinan la base usada incluso con URI específica.
# Desactivar temporalmente arquitectura y opiniones externas:
# CONTENT_ENABLED=false
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER/BASE_DE_DATOS
MONGO_CONTENT_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER_CONTENIDO/BASE_DE_CONTENIDO
JWT_SECRET=reemplazar_por_un_secreto_propio
SESSION_SECRET=reemplazar_por_otro_secreto_propio
# Opcional, solo si tu DNS no resuelve MongoDB Atlas:
# MONGO_DNS_SERVERS=1.1.1.1
