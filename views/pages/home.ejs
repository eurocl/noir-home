<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Noir Home | Bazar</title>

  <link rel="stylesheet" href="/css/style.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
</head>

<body>

  <!-- NAVBAR -->
  <%- include("navigation") %>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-overlay">
      <p class="hero-subtitle">Timeless Interior Objects</p>

      <h1>
        Una mirada conectada a la naturaleza para encontrar paz
      </h1>

      <a href="#products" class="hero-button">
        Explorar colección
      </a>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="categories">

    <% ['All', 'Living', 'Bedroom', 'Bathroom', 'Kitchen', 'Lighting'].forEach(category => { %>
      <button type="button" class="category-card" data-filter="<%= category.toLowerCase() %>"
              aria-pressed="<%= category === 'All' %>" aria-controls="product-grid"><%= category %></button>
    <% }) %>

  </section>

  <!-- PRODUCTS -->
  <section class="products-section" id="products">

    <div class="section-title">
      <p>Curated Collection</p>
      <h2>Featured Products</h2>
    </div>

    <p id="filter-status" class="filter-status" role="status"></p>
    <p id="empty-category" hidden>No products in this category yet.</p>
    <div class="products-grid" id="product-grid">

      <% products.forEach(product => { %>

        <div class="product-card"
             data-category="<%= (product.category || '').toLowerCase().trim() %>">

          <!-- LINK AL DETALLE -->
          <a href="/products/<%= product._id %>" class="product-link">

            <div class="product-image">
              <img src="<%= product.image %>" alt="<%= product.name %>">
            </div>

            <div class="product-info">
              <p class="category"><%= product.category || 'Uncategorized' %></p>
              <h3><%= product.name %></h3>
              <p class="price">$<%= product.price %></p>
            </div>

          </a>

          <!-- BOTÓN ADD TO CART -->
          <% if(userId){ %>
            <form action="/cart/add/<%= product._id %>" method="POST">
              <button type="submit" class="add-cart-btn">
                Agregar al carrito
              </button>
            </form>
          <% } %>

        </div>

      <% }) %>

    </div>

  </section>

  <!-- PERSONAS -->

  <section class="people-section">

    <div class="section-title">

      <p>Opiniones</p>

      <h2>Diseño contado por personas</h2>

    </div>


    <div class="people-grid">

      <% if (people && people.length > 0) { %>

        <% people.forEach(person => { %>

          <div class="person-card">

            <div class="person-image">

              <img
                src="<%= person.imagen %>"
                alt="<%= person.nombre %>"
                width="100"
                height="100"
                loading="lazy"
              >

            </div>


            <div class="person-info">

              <h3>
                <%= person.nombre %>
              </h3>

              <p class="person-role">
                <%= person.role %>
              </p>

              <p class="person-comment">
                "<%= person.comentario %>"
              </p>

            </div>

          </div>

        <% }) %>

      <% } else { %>

        <p>
          <%= typeof contentUnavailable !== 'undefined' && contentUnavailable ? 'Las opiniones no están disponibles temporalmente.' : 'No hay opiniones disponibles.' %>
        </p>

      <% } %>

    </div>

  </section>


  <!-- FILTER SCRIPT -->
  <script src="/js/home.js" defer></script>

</body>
</html>
