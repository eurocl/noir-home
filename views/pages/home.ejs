<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Noir Home</title>

  <link rel="stylesheet" href="/css/style.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
</head>

<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="logo">Noir Home</div>

    <div class="nav-links">
      <a href="/">Inicio</a>
      <a href="/catalog">Catálogo</a>
      <a href="/cart">Carrito</a>

      <% if(userId){ %>
        <a href="/logout">Cerrar sesión</a>
      <% } else { %>
        <a href="/login">Ingresar</a>
      <% } %>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-overlay">
      <p class="hero-subtitle">Timeless Interior Objects</p>

      <h1>
        Una mirada conectada a la naturaleza para encontrar paz
      </h1>

      <a href="#products" class="hero-button">
        Explorar colección
      </a>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="categories">

    <% ['All', 'Living', 'Bedroom', 'Bathroom', 'Kitchen', 'Lighting'].forEach(category => { %>
      <button type="button" class="category-card" data-filter="<%= category.toLowerCase() %>"
              aria-pressed="<%= category === 'All' %>" aria-controls="product-grid"><%= category %></button>
    <% }) %>

    <a href="/about" class="category-card">Sobre nosotros</a>

  </section>

  <!-- PRODUCTS -->
  <section class="products-section" id="products">

    <div class="section-title">
      <p>Curated Collection</p>
      <h2>Featured Products</h2>
    </div>

    <p id="filter-status" class="filter-status" role="status"></p>
    <p id="empty-category" hidden>No products in this category yet.</p>
    <div class="products-grid" id="product-grid">

      <% products.forEach(product => { %>

        <div class="product-card"
             data-category="<%= (product.category || '').toLowerCase().trim() %>">

          <!-- LINK AL DETALLE -->
          <a href="/products/<%= product._id %>" class="product-link">

            <div class="product-image">
              <img src="<%= product.image %>" alt="<%= product.name %>">
            </div>

            <div class="product-info">
              <p class="category"><%= product.category || 'Uncategorized' %></p>
              <h3><%= product.name %></h3>
              <p class="price">$<%= product.price %></p>
            </div>

          </a>

          <!-- BOTÓN ADD TO CART -->
          <% if(userId){ %>
            <form action="/cart/add/<%= product._id %>" method="POST">
              <button type="submit" class="add-cart-btn">
                Agregar al carrito
              </button>
            </form>
          <% } %>

        </div>

      <% }) %>

    </div>

  </section>

  <!-- FILTER SCRIPT -->
  <script src="/js/home.js" defer></script>

</body>
</html>
