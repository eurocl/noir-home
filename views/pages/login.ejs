<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Noir Home | Ingresar
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet"
  >

</head>

<body class="login-page">

  <!-- BACKGROUND IMAGE -->

  <div class="login-hero">

    <img
      src="/images/login-bg.jpg"
      alt="Interior elegante"
    >

  </div>

  <!-- LOGIN CARD -->

  <div class="login-container">

    <form
      class="luxury-login"
    >

      <p class="login-tag">
        NOIR HOME
      </p>

      <h1>
        Te damos la bienvenida
      </h1>

      <p class="login-text">

        Ingresá a tu cuenta para seguir explorando nuestra colección seleccionada.

      </p>

      <input
        type="email"
        name="email"
        placeholder="Correo electrónico"
        required
      >

      <input
        type="password"
        name="password"
        placeholder="Contraseña"
        required
      >

      <button type="submit">

        <span>
          Ingresar
        </span>

      </button>

      <a
        href="/register"
        class="register-link"
      >

        Crear una cuenta

      </a>

    </form>

  </div>

  <script src="/js/login.js"></script>

</body>

</html>