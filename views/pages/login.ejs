<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Noir Home | Ingresar</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/auth.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="auth-page">
<div class="auth-backdrop" aria-hidden="true"></div>
<header class="auth-header"><a class="auth-brand" href="/">NOIR HOME</a><a class="auth-back" href="/">Volver a la colección ↗</a></header>
<main class="auth-main">
<form class="auth-card luxury-login" action="/login" method="POST" aria-labelledby="auth-title">
<p class="auth-eyebrow">Tu espacio en Noir Home</p>
<h1 id="auth-title">Bienvenido de nuevo.</h1>
<p class="auth-description">Ingresá para seguir explorando arquitectura y objetos para habitar.</p>
<div class="auth-fields">

<label class="auth-field" for="email">Correo electrónico<input id="email" type="email" name="email" placeholder="tu@email.com" autocomplete="email" required></label>
<label class="auth-field" for="password">Contraseña<input id="password" type="password" name="password" placeholder="Tu contraseña" autocomplete="current-password"  required></label>

</div>
<button type="submit">Ingresar ↗</button>
<p class="auth-switch">¿Todavía no tenés cuenta? <a href="/register">Crear una cuenta</a></p>
</form>
</main>
<script src="/js/login.js"></script>
</body>
</html>
