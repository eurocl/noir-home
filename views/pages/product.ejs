<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= product.name %> | Proyecto Noir
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet"
  >

</head>

<body>

  <%- include("navigation") %>

  <section class="product-detail">

    <!-- IMAGE -->

    <div class="detail-image">

      <img
        src="<%= product.image %>"
        alt="<%= product.name %>"
      >

    </div>

    <!-- INFO -->

    <div class="detail-info">

      <p class="detail-category">
        <%= product.category || "Sin categoría" %>
      </p>

      <h1>
        <%= product.name %>
      </h1>

      <p class="detail-description">
        <%= product.description %>
      </p>

      <p class="detail-price">
        $<%= product.price %>
      </p>

      <p class="stock" id="product-stock" role="status" data-url="/products/<%= product._id %>/stock">Consultando disponibilidad…</p>
      <button type="button" id="retry-stock" hidden>Volver a consultar</button>

      <form
        action="/cart/add/<%= product._id %>"
        method="POST"
      >

        <button
          type="submit"
          class="add-cart-btn"
          id="add-product"
          disabled
        >
          Agregar al carrito
        </button>

      </form>

    </div>

  </section>

<script src="/js/product-stock.js" defer></script>
</body>

</html>
