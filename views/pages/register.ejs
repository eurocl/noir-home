<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Registrarse</title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

</head>

<body>

  <form
    action="/register"
    method="POST"
    class="auth-form"
  >

    <h1>
      Crear una cuenta
    </h1>

    <input
      type="text"
      name="name"
      placeholder="Nombre completo"
      required
    >

    <input
      type="email"
      name="email"
      placeholder="Correo electrónico"
      required
    >

    <input
      type="password"
      name="password"
      placeholder="Contraseña"
      required
    >

    <p class="password-info">

      La contraseña debe contener:
      <br>
      • Al menos 6 caracteres
      <br>
      • 1 número
      <br>
      • 1 carácter especial (!@#$%^&*)

    </p>

    <button type="submit">

      Registrarse

    </button>

  </form>

</body>

</html>